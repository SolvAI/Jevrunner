# Copy to config.env (not committed) to change how the model runs or where things live.
# Everything here is optional: the defaults work after setup. KEY=VALUE lines, read on Linux, macOS and Windows.

# Which backend serves H2O Lightning 4B (setup picks one and remembers it):
#   vllm      Linux + NVIDIA GPU of 15 GB+ (the default there): the model's own deployment, fastest (~90 ms/decision)
#   llamacpp  everything else: Windows, macOS, smaller or non-NVIDIA GPUs, or the CPU
# BACKEND=llamacpp

# llama.cpp: which GGUF (download size; GPU memory used in the game, measured on an RTX 4090)
#   Q8_0    4.5 GB, the default (~5.1 GB)
#   Q4_K_M  2.7 GB, for small GPUs (~3.4 GB; ~3.3 GB with SLOT_CTX=4096): same decisions on this game, changes ~1
#           answer in 18 in H2O's tests
#   BF16    8.4 GB, full precision
# QUANT=Q4_K_M
# LLAMA_BUILD=auto           # auto | cuda | vulkan | cpu (macOS always uses Metal)
# LLAMA_SERVER=/path/to/llama-server   # use your own llama.cpp build instead of downloading one
# NGL=0                      # layers on the GPU (0 runs on the CPU only: slow, see the README)
# SLOTS=1                    # llama-server slots (more is no faster for this model on llama.cpp)
# SLOT_CTX=8192              # tokens per slot (4096 on a 4 GB GPU)
# IMAGES=1                   # also load the vision projector, for the game's EYES · SCREEN mode (re-run setup)
# LLAMA_ARGS=                # extra llama-server flags

# Where setup puts the big things (model, runtimes, logs). Default: ~/.jevrunner
# JEVRUNNER_HOME=/data/jevrunner

# vLLM: use a model folder you already downloaded (hf download h2oai/h2o-lightning-4b --local-dir ...)
# H2O_DIR=/data/models/h2o-lightning-4b
# H2O_REVISION=v1.2.3        # pin a revision of the model at download time
# VLLM_VENV=/data/envs/vllm  # an existing env with vLLM 0.30.0
# GPU_UTIL=0.6               # vLLM's share of GPU memory (0.85 on a 16 GB card)
# MAX_LEN=8192
# MAX_SEQS=32
# TWO_WAY=0                  # one-way (causal) reading instead of the default two-way

# Another System One endpoint instead of the local H2O (local or hosted). The key stays on the game's server.
# DECIDE_URL=http://127.0.0.1:8742/v1/systemone
# DECIDE_KEY=...
# DECIDE_MODEL=...
# MODEL_LABEL=QUYET          # the name the panel shows (default H2O)

# Ports
# H2O_PORT=8741
# GAME_PORT=5175
