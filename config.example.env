# Copy to config.env (not committed) to change where things live or which model the game talks to.
# Everything here is optional: the defaults work after scripts/setup.sh.

# Where setup puts the big things (vLLM env, model weights, logs). Default: ~/.jevrunner
# JEVRUNNER_HOME=/data/jevrunner

# Use a model folder you already downloaded (hf download h2oai/h2o-lightning-4b --local-dir ...)
# H2O_DIR=/data/models/h2o-lightning-4b
# H2O_REVISION=v1.2.3        # pin a revision of the model at download time
# VLLM_VENV=/data/envs/vllm  # an existing env with vLLM 0.30.0

# GPU sizing of H2O's vLLM (see the README): share of GPU memory, context, requests at a time
# GPU_UTIL=0.6
# MAX_LEN=8192
# MAX_SEQS=32
# TWO_WAY=0                  # one-way (causal) reading instead of the default two-way

# Another System One endpoint instead of the local H2O (local or hosted). The key stays on the game's server.
# DECIDE_URL=http://127.0.0.1:8742/v1/systemone
# DECIDE_KEY=...
# DECIDE_MODEL=...
# MODEL_LABEL=QUYET          # the name the panel shows (default H2O)

# Ports
# H2O_PORT=8741
# GAME_PORT=5175
